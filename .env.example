# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/ecommerce

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-me

# Application and JWT
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
DOMAIN=localhost
PROJECT_NAME=New Technologies Ecommerce
PROJECT_VERSION=1.0.0
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_COOKIE_NAME=nt_admin_session
COOKIE_SECURE=false

# Initial administrator
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-me

# SMTP
MAIL_USERNAME=your-account@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=your-account@example.com
MAIL_FROM_NAME=New Technologies
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Public shop URL used in e-mails
FRONTEND_URL=http://localhost:8001
DASHBOARD_URL=http://localhost:8002
